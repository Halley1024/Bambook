{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bambook",
  "version": "0.1.0",
  "identifier": "com.halley.bambook",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bambook",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["resources/**/*"],
    "shortDescription": "Bambook PDF reader and Markdown editor for Windows"
  }
}
