{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Bambook",
    "version": "0.1.0",
    "identifier": "com.halley.bambook",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Bambook",
                "width": 1280,
                "height": 820,
                "minWidth": 1080,
                "minHeight": 640,
                "decorations": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "targets": [
            "deb",
            "appimage"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png"
        ],
        "shortDescription": "Bambook PDF reader and Markdown editor for Linux"
    }
}